# Release binary archives (hosted on GitHub Releases, never tracked in Git tree)
Releases/**/*.zip
Releases/**/*.tar.gz
Releases/**/*.tgz
Releases/**/*.7z

# Unpacked release working directories (only markdown docs and checksums are tracked)
Releases/V1.0.0-Beta/Aarkam.AM/
Releases/V1.0.0-Beta/AarkamIO/
Releases/**/win/
Releases/**/linux/
Releases/**/win-x64/
Releases/**/linux-x64/

# Whitelist markdown documentation and checksums in release directories
!Releases/**/*.md
!Releases/**/SHA256SUMS.txt
!Releases/**/checksums.sha256
!Releases/**/LICENSE

# IDE / Build Artifacts
.vs/
.idea/
bin/
obj/
*.user
*.suo

# OS files
.DS_Store
Thumbs.db

dist/
